

# --- analytics (optional) ---------------------------------------------------
# CleverTap Account ID: dashboard → Settings → Project → Account ID.
# Leave unset and analytics is a silent no-op.
VITE_CLEVERTAP_ID=
# Must match your dashboard's region. in1 = India (also us1, eu1, sg1, aps3, mec1).
VITE_CLEVERTAP_REGION=in1
# 'true' lets CleverTap derive city/country from the request IP. Default off.
VITE_CLEVERTAP_USE_IP=false
